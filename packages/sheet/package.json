{
  "name": "@framv/sheet",
  "version": "0.1.1",
  "private": false,
  "description": "Spreadsheet component for framv — sort, filter, formulas and CSV export as a declarative custom element",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && npm run bundle",
    "prepublishOnly": "npm run build",
    "bundle": "esbuild src/index.ts --bundle --format=esm --external:@framv/core --outfile=dist/bundle.esm.js && esbuild src/cdn.ts --bundle --format=iife --global-name=FramvSheet --outfile=dist/bundle.iife.js"
  },
  "dependencies": {
    "@framv/core": "*",
    "jspdf": "^4.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  },
  "author": "Mens Reversa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mensreversa/framv.git",
    "directory": "packages/sheet"
  },
  "bugs": {
    "url": "https://github.com/mensreversa/framv/issues"
  }
}
